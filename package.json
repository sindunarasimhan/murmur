{
  "name": "murmur",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "./script/build_and_run.sh",
    "ios": "./script/build_and_run.sh --ios",
    "web": "./script/build_and_run.sh --web",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test:unit": "tsx --test \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "eval:jev": "node --env-file-if-exists=.env.local --import tsx scripts/evaluate-jev.ts",
    "backend:db": "docker compose up -d --wait",
    "backend:api": "node --env-file-if-exists=.env.local --import tsx backend/main.ts",
    "backend:worker": "node --env-file-if-exists=.env.local --import tsx backend/worker.ts",
    "catalog:import": "node --env-file-if-exists=.env.local --import tsx scripts/import-lenny.mts",
    "eval:lenny": "node --import tsx scripts/evaluate-lenny.mts",
    "test:backend": "node --import tsx --test backend/*.test.ts",
    "fixture:episode": "node scripts/build-prepared-episode.mjs",
    "eval:listening": "node --env-file-if-exists=.env.local --import tsx scripts/evaluate-listening.mts",
    "smoke:listening": "node --import tsx scripts/smoke-listening.mts",
    "listening:dev": "./script/build_and_run.sh"
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@fastify/websocket": "^11.3.1",
    "@react-native-community/slider": "5.2.0",
    "expo": "~57.0.24",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "pg-boss": "^12.33.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.2.2",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "eslint-import-resolver-typescript": "4.4.5",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "eslint-import-resolver-typescript": "4.4.5"
  }
}
