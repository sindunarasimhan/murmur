# Server-only. Never prefix this value with EXPO_PUBLIC_.
OPENAI_API_KEY=

# Optional server model overrides.
OPENAI_RESPONSE_MODEL=gpt-5.4-mini
# Optional: use a smaller model only for confident, simple Jev-classified explanations.
# Leave blank to retain the main answer model for every question.
OPENAI_FAST_RESPONSE_MODEL=
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-live-transcribe
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
OPENAI_SPEECH_VOICE=cedar

# Required for Jev semantic decisions in /listen. Optional for the legacy Home flow.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Optional client escape hatch. Foreground playback wake listening is on by default.
# EXPO_PUBLIC_MURMUR_WAKE_WORD=off

# Required by production native builds after the Expo server is deployed.
# Leave empty in local development; Expo routes relative requests to the dev server.
EXPO_PUBLIC_API_URL=

# New listening backend. Defaults below work with the bundled local Docker database.
# Leave DATABASE_URL unset to let the Run action start Docker automatically.
# DATABASE_URL=postgres://murmur:murmur-local-development@127.0.0.1:55432/murmur
# MURMUR_OBJECT_DIR=.murmur-data/objects
# MURMUR_BACKEND_PORT=4545
# MURMUR_BACKEND_HOST=0.0.0.0
# MURMUR_BACKEND_URL=http://127.0.0.1:4545
# Default: the reviewed Brian Halligan episode. Set all to restore the wider catalog.
# MURMUR_CATALOG=all
# Limits count operations, not dollars. A spoken question can consume three operations.
# MURMUR_DAILY_USER_CALLS=60
# MURMUR_DAILY_PROJECT_CALLS=300
# Required for deployed clients; use wss://your-voice-host/v2/voice.
# Local clients use the Expo host at port 4545 automatically.
# EXPO_PUBLIC_MURMUR_VOICE_URL=
